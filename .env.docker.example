# Browser-facing address used when the UI copies a rule URL. For LAN access,
# replace this with the VPS/LAN IP or your HTTPS domain.
PUBLIC_BASE_URL=http://192.168.1.10:8080
HTTP_PORT=8080

# Persistent host directory for SQLite, JSON, SRS/MRS, and version history.
DATA_DIR=./data

# Full SRS and MRS support. Keep enabled to retain every upstream feature.
BUILD_BINARY_RULESETS=true
SRS_CONCURRENCY=2
MRS_CONCURRENCY=2

# Check upstream once per day and keep the current plus previous data version.
UPDATE_INTERVAL_SECONDS=86400
KEEP_DATA_VERSIONS=2
